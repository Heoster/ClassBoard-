# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Your Supabase project URL — found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Your Supabase publishable (anon) key — found in Project Settings > API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Optional HTTPS service that converts PPT/PPTX to PDF. It must authenticate requests.
PRESENTATION_CONVERTER_URL=
PRESENTATION_CONVERTER_TOKEN=
